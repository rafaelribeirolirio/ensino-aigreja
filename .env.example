# --- Banco de dados ---
# Producao (Supabase): use a Connection String "Pooler" do projeto.
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Desenvolvimento local (Prisma dev): rode `npx prisma dev -d` e copie a URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/celulas_aig?sslmode=disable"
# Necessário com o Prisma dev (não permite usar template1 como shadow db).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51218/celulas_aig_shadow?sslmode=disable"

# --- Better Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "true" em produção. Em dev, use "false" para entrar sem o link de verificação.
REQUIRE_EMAIL_VERIFICATION="true"

# --- E-mail (Resend) ---
# Sem chave, o link de verificacao e impresso no console (apenas dev).
RESEND_API_KEY=""
EMAIL_FROM="Plataforma da Igreja <nao-responda@exemplo.com>"

# --- Supabase Storage (PDFs, ebooks, imagens) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
